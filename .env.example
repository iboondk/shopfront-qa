# Placeholder values only. Copy to .env to use; no real credentials belong here.
# BASE_URL and API_URL here point at a running stub on 3100. If API_URL is unset, the API suite starts
# its own stub on 3101 instead. STUB_HEALTH_TIMEOUT_S (default 60) is the health wait for a self-started stub.
BASE_URL=http://127.0.0.1:3100
API_URL=http://127.0.0.1:3100
GRAPHQL_URL=http://127.0.0.1:3100/graphql
PUBLISHABLE_KEY=pk_test_stub
TARGET=stub
STUB_LATENCY_MS=0
STUB_FLAKE_RATE=0
STUB_SEED=42
STUB_HEALTH_TIMEOUT_S=60
