# Copy this file to tools/scripts/local.env (untracked, gitignored) to override machine-specific settings.
# Every line here is optional. Unset variables fall back to the tool defaults.
#
# Example for a machine with an external cache volume:
# export npm_config_cache=/Volumes/Hazel/caches/npm
# export PIP_CACHE_DIR=/Volumes/Hazel/caches/pip
# export PLAYWRIGHT_BROWSERS_PATH=/Volumes/Hazel/caches/ms-playwright
# export CYPRESS_CACHE_FOLDER=/Volumes/Hazel/caches/cypress
# export SE_CACHE_PATH=/Volumes/Hazel/caches/selenium
